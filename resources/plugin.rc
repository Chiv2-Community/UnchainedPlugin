1 VERSIONINFO
FILEVERSION PLUGIN_VERSION_NUM
PRODUCTVERSION PLUGIN_VERSION_NUM
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x2
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "UnchainedPlugin Contributors\0"
            VALUE "FileDescription", "UnchainedPlugin\0"
            VALUE "FileVersion", PLUGIN_VERSION
            VALUE "InternalName", "UnchainedPlugin\0"
            VALUE "LegalCopyright", "Copyright (C) 2023-2025\0"
            VALUE "OriginalFilename", "UnchainedPlugin.dll\0"
            VALUE "ProductName", "UnchainedPlugin\0"
            VALUE "ProductVersion", PLUGIN_VERSION
            VALUE "GitCommit", PLUGIN_GIT_COMMIT
            VALUE "GitDirty", PLUGIN_GIT_DIRTY
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 0x04b0
    END
END
